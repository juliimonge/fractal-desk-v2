# Build artefacts — regenerated by `./run.sh`, never committed.
build/
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Credentials and keys.
#
# This repository must never contain a cryptographic key. It does not have one,
# has no code that could use one, and no code that could transmit a document.
# These patterns exist so that an accidental drop of a key file into the working
# tree cannot be committed — belt and braces on a property that is enforced in
# the test suite (tests/test_submission_mock.py).
# ---------------------------------------------------------------------------
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.jks
.env
.env.*
secrets/
credentials/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
